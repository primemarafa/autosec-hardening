# ==============================================================================
# AutoSec-Hardener : Configuration Fail2ban (Protection Anti-Brute-Force)
# Fichier cible : /etc/fail2ban/jail.local
# ==============================================================================

[DEFAULT]
# Adresses IP ou sous-réseaux locaux à ne JAMAIS bannir (Whitelist)
ignoreip = 127.0.0.1/8 ::1 192.168.1.0/24

# Durée de bannissement : 1 heure (3600 secondes)
bantime  = 1h

# Fenêtre de temps pour comptabiliser les échecs : 10 minutes (600 secondes)
findtime = 10m

# Nombre maximal d'échecs avant bannissement
maxretry = 3

# Action de bannissement via le pare-feu
banaction = ufw
banaction_allports = ufw

# Mode de détection des logs
backend = systemd

# ------------------------------------------------------------------------------
# Prison SSH (sshd)
# ------------------------------------------------------------------------------
[sshd]
enabled = true
port    = ssh
logpath = %(sshd_log)s
maxretry = 3
bantime  = 24h
